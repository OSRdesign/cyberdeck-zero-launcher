title s7 portrait switcher
review
sizes 800x1280 600x1024
profile pda
@800x1280 env APPLAUNCH_PANEL_MM 150x93
@600x1024 env APPLAUNCH_PANEL_MM 154x90
env APPLAUNCH_DEV 1
apps Settings Store CLI SSH Calculator Python "Mesh Hop=ip_panel_100.png" "RSS Reader=store_100.png" "Net Toolbox=ssh_100.png" "Serial Console=cli_100.png" "System Monitor=game_100.png"
clock 20:30
wifi 70
bt on
home
switcher "Mesh Hop=front" "RSS Reader=running" "Net Toolbox=paused"
shot s7_por_switcher
expect_targets
switcher off
launch Settings
key UP
key ENTER
key UP
key UP
key UP
key ENTER
expect_zone shown
turnedapp on
expect_vkb auto
shot s7_por_turned
turnedapp off
