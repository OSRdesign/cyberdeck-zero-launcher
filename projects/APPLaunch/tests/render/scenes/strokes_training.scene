shot strokes_training_picked
tapbutton "Reset all"
shot strokes_training_reset
key ESC
tapbutton Finish
expect_text "Check b  (1/2)"
shot strokes_training_retest
stroke letters 60,20 60,45 60,70 60,95 60,120 60,105 60,90 61,78 66,70 75,64 87,62 100,64 111,70 118,80 121,92 119,104 113,113 102,119 88,120 74,119 64,117
expect_text "Check e  (2/2)"
stroke letters 109,39 105,34 101,30 96,27 90,25 84,25 77,26 70,27 65,28 59,32 55,36 53,41 52,47 52,53 53,59 57,63 62,66 68,68 74,69 80,70 86,72 88,72 82,73 77,74 70,75 62,76 58,79 54,83 52,89 51,95 50,100 50,105 52,112 56,118 62,122 66,124 72,125 78,125 84,125 90,124 96,121 102,117 106,113 111,109 114,105 120,99
expect_text "Summary"
