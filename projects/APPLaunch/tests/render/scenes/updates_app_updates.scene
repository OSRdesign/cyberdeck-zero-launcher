# Settings > Updates > App updates (report 047 P3, D19): the row shows the number of installed apps with an update on offer
# (the Apps page's catalogue: 2, amber), and opens Settings > Apps > Installed (Update all (2), the apps with their
# versions). Esc goes back to the Settings list (the Apps row). Keys only.
# Review only: no golden; the headers are checked against the home grid's.
title updates app updates
review
sizes 640x480 480x800 480x640 720x720 1280x800 480x320
@480x800,480x640 profile pda
env APPLAUNCH_DEV 0
env HARNESS_APPS catalogue
env M5APPSTORE_STATE_DIR /nonexistent/harness-appstore
apps Settings CLI SSH Calculator
clock 20:30 2026-11-01
wifi 70
bt on
update net on
update build 0.9.1 release arm64
update answer releases-real.json
apt board empty
apt lists-age 1
home
launch Settings
wait 300
key UP
key UP
key UP
key UP
key ENTER
wait 3000
shot appupdates_root
expect_text "2 updates"
expect_color "2 updates" F0B400
key DOWN
key DOWN
key ENTER
wait 3000
shot appupdates_installed
header appupdates_installed "Settings > Apps > Installed" "Apps > Installed" Installed
expect_text "Update all (2)"
key ESC
wait 300
key ESC
wait 300
shot appupdates_back
