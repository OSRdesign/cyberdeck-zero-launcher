# Multitasking P-d (task 015-pd): the switcher screen "Open apps" of the approved mockup, built as multitask_ui builds
# it from the supervisor's report: the shared page header (title, Esc, status strip), a fixed 2x2 grid of cards (icon,
# name on up to two lines, the state with its dot, the X in the corner), a free slot "Room for one more", the bar Home |
# Close all, the blue selection. Checked: every touch target at least 7 mm and nothing outside the panel
# (expect_targets), the header against the home grid's, taps (a card, an X at the far corner of its 7 mm target, Home,
# Close all) and keys (Esc, Backspace, arrows, Enter) reach the right action. The switcher exists from a short side of
# 480 up (smaller panels keep the P-b / P-c behaviour): 480x320 is not rendered; the portrait 480x640 and 480x800 are in
# pda_switcher.scene. 1024x600 at its real 6.6 px/mm.
title multitask switcher
sizes 640x480 800x480 720x720 1280x720 1024x600
@1024x600 ppmm 660
apps "Serial Console=cli_100.png" "Mesh Hop=ip_panel_100.png" "RSS Reader=fixture:store_100.png" "System Monitor=game_100.png" "Spectrum Analyzer for the Software Defined Radio=tank_100.png" "Net Toolbox=ssh_100.png" "An App With A Thirty Char Name=math_100.png" Settings
clock 20:30
wifi 70
bt on
home
header home
# three apps, opened from Serial Console (In front), a free slot
switcher "Serial Console=front" "Mesh Hop=running" "RSS Reader=paused"
shot switcher_three
header switcher "Open apps"
expect_targets
tapitem close1 edge
expect_event close Mesh Hop
tapitem close0
expect_event close Serial Console
tapitem card2
expect_event pick RSS Reader
tapitem home
expect_event home
tapitem closeall
expect_event close-all
key ESC
expect_event cancel
key BACKSPACE
expect_event cancel
# keyboard from the first card: Right (Mesh Hop), Down (no card under it: Close all), Down (stays), Enter on Close
# all; then Tab twice (wraps to the first card, then Mesh Hop)
switcher select card0
key RIGHT
key DOWN
key DOWN
shot switcher_keys
key ENTER
expect_event close-all
key TAB
key TAB
shot switcher_tab
# an app that stopped answering: amber
switcher "Serial Console=front" "Mesh Hop=running" "System Monitor=nr"
switcher select card0
shot switcher_not_responding
# four apps (the cap): no free slot
switcher "RSS Reader=front" "Mesh Hop=running" "Serial Console=nr" "System Monitor=paused"
shot switcher_four
expect_targets
# long names wrap onto two lines (the second one ends with dots when even that is not enough)
switcher "Serial Console=front" "System Monitor=running" "Net Toolbox=paused" "An App With A Thirty Char Name=nr"
switcher select card0
shot switcher_names
expect_targets
# one app with a long name (two lines, the second cut with dots), three free slots
switcher "Spectrum Analyzer for the Software Defined Radio=front"
shot switcher_one
expect_targets
switcher off
