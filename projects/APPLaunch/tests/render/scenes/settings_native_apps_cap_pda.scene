# Settings > Apps' capped description on the portrait PDA profile (task C1): the flow of settings_native_apps_cap at
# 480x640 and 480x800 (review only, no goldens).
title settings native apps description cap pda
review
sizes 480x640 480x800
profile pda
env APPLAUNCH_PDA 0
env APPLAUNCH_DEV 0
env APPLAUNCH_OSK auto
env HARNESS_APPS catalogue
env HARNESS_APPS_DESC on
env M5APPSTORE_STATE_DIR /nonexistent/harness-appstore
keyboards 1
apps Settings Store CLI SSH Calculator
clock 20:30
wifi 70
bt on
home
launch Settings
key UP
key UP
key UP
key UP
key UP
key ENTER
wait 3000
key DOWN
key ENTER
wait 500
key ENTER
wait 500
shot cap_avail_page
expect_rows Description Install Cancel
key ENTER
wait 500
shot cap_avail_text_top
key END
wait 500
shot cap_avail_text_bottom
key ESC
wait 500
key ESC
wait 500
key LEFT
wait 500
key UP
key ENTER
wait 500
key DOWN
key ENTER
wait 500
key ENTER
wait 500
shot cap_inst_text_top
key END
wait 500
shot cap_inst_text_bottom
