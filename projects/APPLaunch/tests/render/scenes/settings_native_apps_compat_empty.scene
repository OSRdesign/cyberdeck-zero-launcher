# Settings > Apps > Available when no app fits the screen (every fixture app needs 2000x1500, fixtures/apps-cache-big):
# the Available list shows the normal empty-list text and nothing else, the root's count is 0, Installed is untouched.
# Review only, no golden.
title settings native apps screen filter empty
review
env APPLAUNCH_DEV 0
env APPLAUNCH_OSK auto
env HARNESS_APPS catalogue
env HARNESS_APPS_DESC on
env HARNESS_APPS_NEEDS big
env M5APPSTORE_STATE_DIR /nonexistent/harness-appstore
keyboards 1
apps Settings CLI SSH Calculator
clock 20:30
wifi 70
bt on
home
launch Settings
key UP
key UP
key UP
key UP
key UP
key ENTER
wait 3000
shot compat_empty_root
key DOWN
key ENTER
wait 500
shot compat_empty_available
expect_rows "Nothing to install"
