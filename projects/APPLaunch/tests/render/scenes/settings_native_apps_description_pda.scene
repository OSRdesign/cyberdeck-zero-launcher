# Settings > Apps' Description row and its text page on the portrait PDA profile (task C1): the same fake catalogue and
# keyboard flow as settings_native_apps_description at 480x640 and 480x800 (no writing zone, no goldens: review only).
title settings native apps description pda
review
sizes 480x640 480x800
profile pda
env APPLAUNCH_PDA 0
env APPLAUNCH_DEV 0
env APPLAUNCH_OSK auto
env HARNESS_APPS catalogue
env HARNESS_APPS_DESC on
env M5APPSTORE_STATE_DIR /nonexistent/harness-appstore
keyboards 1
apps Settings CLI SSH Calculator
clock 20:30
wifi 70
bt on
home
launch Settings
key UP
key UP
key UP
key UP
key UP
key ENTER
wait 3000
key ENTER
wait 500
shot apps_desc_installed
key DOWN
key ENTER
wait 500
shot apps_desc_list_long
expect_rows Description Remove Cancel
expect_chevron Description yes
key ENTER
wait 500
shot apps_desc_text_top
key DOWN
key DOWN
key DOWN
key DOWN
key DOWN
key DOWN
wait 500
shot apps_desc_text_page
key END
wait 500
shot apps_desc_text_bottom
key ESC
wait 500
shot apps_desc_list_back
expect_rows Description Remove Cancel
key ESC
wait 500
key DOWN
wait 300
key ENTER
wait 500
shot apps_desc_list_short
expect_rows Description Update Remove Cancel
key ENTER
wait 500
shot apps_desc_text_short
key ESC
wait 500
key ESC
wait 500
key DOWN
key ENTER
wait 500
shot apps_desc_list_none
expect_rows Update Remove Cancel
