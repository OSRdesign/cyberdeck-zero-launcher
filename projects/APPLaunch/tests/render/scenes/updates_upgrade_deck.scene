# Settings > Updates > Packages (report 047 P4, the closure) on the deck case of P4's first board test
# (tests/fixtures/apt/deck-p4): apt upgrades libcurl3t64-gnutls only with curl and libcurl4t64 (one source), chain-tool
# only with the new libchain1, which needs the new libssl3t64, and raspberrypi-sys-mods only with new boot firmware. The
# list after the plan: the packages that pull a launcher library moved to "Launcher libraries" with what they drag
# (libcurl3t64-gnutls, chain-tool, libchain1: 6 in all), the one that pulls the boot chain moved to "Needs the terminal";
# the row offers exactly the closure: "Upgrade 21 packages". Every row pinned (expect_rows); the moved group whole on the
# screen with the highlight on it. Keys only. Review only: no golden.
title updates upgrade deck
review
sizes 640x480 480x800 480x640 720x720 1280x800 480x320
@480x800,480x640 profile pda
env APPLAUNCH_DEV 0
env HARNESS_APPS missing
env HARNESS_SUDO ok
apps Settings CLI SSH Calculator
clock 20:30 2026-11-01
wifi 70
bt on
update net on
update build 0.9.2 release arm64
update answer releases-real.json
apt board deck-p4
apt lists-age 1
home
launch Settings
wait 300
key UP
key UP
key UP
key UP
key ENTER
wait 3000
key DOWN
key ENTER
wait 2000
shot upgrade_deck_list
expect_text "Upgrade 21 packages"
expect_rows "Refresh lists" "Upgrade 21 packages" "SAFE TO UPGRADE (21)" "cifs-utils" "libcamera-ipa" "libcamera0.7" "libexpat1" "libnss3" "libntfs-3g89t64" "libpipewire-0.*" "librpicam-app1" "librsvg2-2" "librsvg2-com*" "ntfs-3g" "pipewire" "pipewire-bin" "raspi-config" "rpi-connect-lite" "rpicam-apps-lite" "tzdata" "vim" "vim-common" "vim-runtime" "xxd" "LAUNCHER LIBRARIES (6)" "chain-tool" "curl" "libchain1" "libcurl3t64-gn*" "libcurl4t64" "libssl3t64" "KERNEL, FIRMWARE AND BOOT (1)" "raspi-firmware" "NEEDS THE TERMINAL (1)" "raspberrypi-s*" "ON THIS BOARD" "Automatic updates"
# the moved group on the screen: from the end up to its first row
key END
key UP
key UP
key UP
key UP
key UP
key UP
key UP
key UP
wait 400
shot upgrade_deck_libraries
expect_unclipped "chain-tool" "curl" "libchain1" "libcurl4t64" "libssl3t64"
key ESC
key ESC
key ESC
wait 300
