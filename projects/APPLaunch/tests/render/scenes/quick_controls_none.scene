# Quick controls on a board with neither a Wi-Fi nor a Bluetooth adapter: both radio buttons dimmed, "Not available";
# the power buttons stay live. Enter on a dimmed button changes nothing.
# Review only: no golden.
title quick controls none
review
env APPLAUNCH_DEV 0
env APPLAUNCH_QUICKCTL_ADAPTERS none
apps Settings CLI "Quick controls" SSH Calculator
clock 20:30
wifi off
bt off
home
launch "Quick controls"
wait 600
shot qc_no_adapters
key ENTER
key RIGHT
key ENTER
wait 300
expect_radio wifi on
expect_radio bt off
expect_power none
