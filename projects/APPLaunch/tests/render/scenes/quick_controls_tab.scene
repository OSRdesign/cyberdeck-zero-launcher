# Quick controls, Tab and Shift+Tab (the raw KEY_TAB the keyboard delivers, not LV_KEY_NEXT): the focus goes round the four
# buttons Shutdown, Reboot, Wi-Fi, Bluetooth and wraps. Where it stands is read from what Enter does, never on a power
# button: opened on Wi-Fi, Tab goes to Bluetooth (Enter: Bluetooth off), Tab x3 round Shutdown and Reboot back to Wi-Fi
# (Enter: Wi-Fi off); Shift+Tab goes back through Reboot and Shutdown and wraps to Bluetooth (Enter: Bluetooth on).
# Moving the focus starts nothing (expect_power none). Review only: no golden.
title quick controls tab
review
env APPLAUNCH_DEV 0
env APPLAUNCH_QUICKCTL_ADAPTERS all
apps Settings CLI "Quick controls" SSH Calculator
clock 20:30
wifi 70
bt on
home
launch "Quick controls"
wait 600
key TAB
shot qc_tab_bluetooth
key ENTER
wait 400
expect_radio bt off
expect_radio wifi on
key TAB
shot qc_tab_shutdown
key TAB
shot qc_tab_reboot
key TAB
shot qc_tab_wifi
key ENTER
wait 400
expect_radio wifi off
expect_radio bt off
expect_power none
key SHIFT+TAB
shot qc_shifttab_reboot
key SHIFT+TAB
shot qc_shifttab_shutdown
key SHIFT+TAB
shot qc_shifttab_bluetooth
key ENTER
wait 400
expect_radio bt on
expect_radio wifi off
expect_power none
