# CopyButton (docs/dev/clipboard.md, step 2): a Copy button for a read-only value, round at the end of a row (@0) or a pill under a
# block value (@1); a value that is empty is greyed (@2). A tap copies the whole value and shows a green check (pill: Copied) for
# 2 s. Without a clipboard (an old launcher) it is greyed. Review only.
title Copy button for read-only values
review
sizes 800x480 640x480 480x320
env APPLAUNCH_DEV 0
env APPLAUNCH_OSK auto
keyboards 1
apps Settings CLI SSH Calculator
clock 20:30
wifi 70
bt on
home
clipboard server on
clipboard clear
copydemo
wait 300
expect_strip @0 copied=no enabled=yes
expect_strip @1 copied=no enabled=yes
expect_strip @2 enabled=no
shot copy_buttons
tapclip @0
clipboard expect "329a4f1c8be277d05c09a1e3b6f4c109"
expect_strip @0 copied=yes
shot copy_button_copied
wait 2200
expect_strip @0 copied=no
tapclip @1
clipboard expect "https://example.test/a/long/value"
expect_strip @1 copied=yes
shot copy_pill_copied
# a greyed button does nothing
clipboard set "keep"
tapclip @2
clipboard expect "keep"
expect_strip @2 copied=no enabled=no
# an old launcher: greyed, built that way
clipboard server old
wait 3200
copydemo
wait 300
expect_strip @0 enabled=no
expect_strip @1 enabled=no
shot copy_buttons_old_launcher
