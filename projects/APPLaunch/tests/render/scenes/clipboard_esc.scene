# Esc in the shared TextField with the clipboard strip (docs/dev/clipboard.md, step 2): with a selection Esc takes two steps (the
# first clears the selection, the second ends the editing and the strip with it); without a selection one Esc ends the editing as
# before. Review only.
title text field: Esc with and without a selection
review
sizes 800x480 640x480 480x320
env APPLAUNCH_DEV 0
env APPLAUNCH_OSK auto
keyboards 1
apps Settings CLI SSH Calculator
clock 20:30
wifi 70
bt on
home
clipboard server on
clipboard clear
fielddemo
wait 300
expect_strip Name editing=yes paste=off
key SHIFT+LEFT
key SHIFT+LEFT
expect_selection Name 14 16
key ESC
expect_selection Name none
expect_strip Name editing=yes copy=on
expect_field Name "café €5 and more"
shot esc_first
key ESC
expect_strip Name none editing=no
shot esc_second
# no selection: one Esc
tapfield Name
expect_strip Name editing=yes copy=on
key ESC
expect_strip Name none editing=no
# Ctrl+A selects all; the first Esc clears it, the second ends the editing
tapfield Name
key CTRL+A
expect_selection Name 0 16
key ESC
expect_selection Name none
expect_strip Name editing=yes
key ESC
expect_strip Name none editing=no
