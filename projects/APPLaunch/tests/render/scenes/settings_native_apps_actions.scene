# Native Settings > Apps action lists (task 014 P3d, Controller decision; P3e: Installed / Available split), with a
# physical keyboard (APPLAUNCH_OSK=auto, one keyboard present) on the fake catalogue (src/harness_apps.cpp). On
# Installed, Enter or a tap opens an app's list; on Available, Enter or a tap opens its page (Install, Cancel; Description when it has one); on Sources a
# tap opens the source's list, Enter keeps the legacy on / off. Shots: Packet Radar's list by a tap (Update, Remove,
# Cancel), its Remove confirmation, the list after Cancel, back on Packet Radar (Cancel row); Field Notes by Enter
# (current: Remove, Cancel); Signal Meter on Available by a tap (its page: Install, Cancel), a tap on Install (the install starts and fails: the notice);
# field-kit/tools by a tap (Disable, Sync, Remove, Cancel; its failure in the status line), Sync of that source alone
# and its result; old/archive by a tap (Enable, Remove, Cancel) and enabled.
# Centre (highlighted) row: 480x320 y 180, 640x480 y 267, 800x480 y 268, 720x720 y 392, 1280x720 y 391.
# Review only, no golden.
title settings native apps action lists
review
env APPLAUNCH_DEV 0
env APPLAUNCH_OSK auto
env HARNESS_APPS catalogue
env M5APPSTORE_STATE_DIR /nonexistent/harness-appstore
keyboards 1
apps Settings Store CLI SSH Calculator
clock 20:30
wifi 70
bt on
home
launch Settings
key UP
key UP
key UP
key UP
key UP
key ENTER
wait 3000
# Installed: Update all (2), Field Notes, Packet Radar, Weather Station...
key ENTER
wait 500
key DOWN
key DOWN
wait 300
@480x320 tap 240 180
@640x480 tap 320 267
@800x480 tap 400 268
@720x720 tap 360 392
@1280x720 tap 640 391
wait 300
shot apps_actions_update
header apps_actions_update "Settings > Apps > Installed > Packet Radar" "Apps > Installed > Packet Radar" "Installed > Packet Radar" "Packet Radar"
key DOWN
key ENTER
wait 300
shot apps_actions_remove_confirm
key ESC
wait 300
shot apps_actions_after_cancel
key DOWN
key ENTER
wait 500
shot apps_actions_closed
header apps_actions_closed "Settings > Apps > Installed" "Apps > Installed" Installed
# Field Notes (current): Enter opens its list
key UP
key ENTER
wait 300
shot apps_actions_current
key ESC
wait 300
# Available: Bench Tools, Signal Meter; a tap on Signal Meter opens its page, a tap on Install installs it (the harness refuses while preparing)
key LEFT
wait 300
key DOWN
key ENTER
wait 500
key DOWN
wait 300
@480x320 tap 240 180
@640x480 tap 320 267
@800x480 tap 400 268
@720x720 tap 360 392
@1280x720 tap 640 391
wait 500
shot apps_actions_available_page
@480x320 tap 240 180
@640x480 tap 320 267
@800x480 tap 400 268
@720x720 tap 360 392
@1280x720 tap 640 391
wait 3000
shot apps_actions_install
key ESC
wait 300
# Sources: field-kit/tools (row 1) by a tap; Sync (this source alone)
key LEFT
wait 300
key DOWN
key ENTER
wait 300
key DOWN
wait 300
@480x320 tap 240 180
@640x480 tap 320 267
@800x480 tap 400 268
@720x720 tap 360 392
@1280x720 tap 640 391
wait 500
shot apps_actions_source
header apps_actions_source "Settings > Apps > Sources > field-kit/tools" "Apps > Sources > field-kit/tools" "Sources > field-kit/tools" "field-kit/tools"
key DOWN
key ENTER
wait 3000
# the highlight on deck-lab/apps: the status line shows the run's result ("Sync failed", red), not the source's reason
# (which reads the build box's default route)
key UP
wait 300
shot apps_actions_source_synced
# old/archive (off, row 2): Enable
key DOWN
key DOWN
wait 300
@480x320 tap 240 180
@640x480 tap 320 267
@800x480 tap 400 268
@720x720 tap 360 392
@1280x720 tap 640 391
wait 500
shot apps_actions_source_off
key ENTER
wait 3000
shot apps_actions_source_enabled
