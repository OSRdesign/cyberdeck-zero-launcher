# The clipboard strip in the other states (docs/dev/clipboard.md, step 2): a Password field (Paste and Clear, no Copy, and nothing
# reaches the clipboard), a launcher without the clipboard (`old`: Paste and Copy greyed, nothing happens), no launcher at all
# (`off`), a stalled one (`slow`: Paste greyed after the first timeout), a field whose app keeps the row (Raw: no strip) and a
# field with a maximum length (Paste cut). The tap on a strip button never ends the editing. Review only.
title clipboard strip: password, old launcher, no launcher
review
sizes 800x480 640x480 480x320
env APPLAUNCH_DEV 0
env APPLAUNCH_OSK auto
keyboards 1
apps Settings CLI SSH Calculator
clock 20:30
wifi 70
bt on
home
clipboard server on
clipboard set "cl1pboard"
fielddemo
wait 300
# the password field: Paste and Clear; no Copy, and the text never reaches the clipboard
key DOWN
key DOWN
key DOWN
expect_strip Secret paste=on copy=hide clear=on editing=yes
shot strip_password
key CTRL+C
clipboard expect "cl1pboard"
tapclip Secret Paste
expect_field Secret "hunter2cl1pboard"
tapclip Secret Clear
expect_field Secret ""
expect_strip Secret paste=on copy=hide clear=hide editing=yes
clipboard expect "cl1pboard"
# an old launcher: the capability is absent, Paste and Copy are greyed, a tap does nothing
clipboard server old
key UP
key UP
key UP
expect_strip Name paste=off copy=off clear=on editing=yes
shot strip_old_launcher
tapclip Name Paste
expect_field Name "café €5 and more"
tapclip Name Copy
expect_strip Name copy_text=Copy
tapclip Name Clear
expect_field Name ""
expect_strip Name paste=off copy=off clear=hide
# no launcher at all
clipboard server off
key DOWN
expect_strip Address paste=off copy=off clear=on editing=yes
# the launcher is there again: the strip asks again when a field starts editing (after the 3 s the toolkit waits)
clipboard server on
clipboard set "back"
wait 3200
key DOWN
key DOWN
key DOWN
expect_strip Short paste=on copy=on clear=on editing=yes
tapclip Short Clear
tapclip Short Paste
expect_field Short "back"
# a field of 8 bytes: Paste is cut at the maximum
clipboard set "0123456789"
tapclip Short Clear
tapclip Short Paste
expect_field Short "01234567"
# the field whose app keeps the row and the Ctrl keys: no strip
key DOWN
expect_strip Raw none editing=yes
shot strip_raw_none
# a stalled launcher: the first timeout greys Paste and Copy
clipboard server slow
wait 3200
key UP
key UP
key UP
key UP
key UP
expect_strip Name paste=off copy=off editing=yes
