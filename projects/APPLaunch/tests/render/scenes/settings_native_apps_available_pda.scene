# Settings > Apps > Available's app page on the portrait PDA profile (task C1): the keyboard flow of
# settings_native_apps_available at 480x640 and 480x800 (no writing zone; review only, no goldens).
title settings native apps available page pda
review
sizes 480x640 480x800
profile pda
env APPLAUNCH_PDA 0
env APPLAUNCH_DEV 0
env APPLAUNCH_OSK auto
env HARNESS_APPS catalogue
env HARNESS_APPS_DESC on
env M5APPSTORE_STATE_DIR /nonexistent/harness-appstore
keyboards 1
apps Settings Store CLI SSH Calculator
clock 20:30
wifi 70
bt on
home
launch Settings
key UP
key UP
key UP
key UP
key UP
key ENTER
wait 3000
key DOWN
key ENTER
wait 500
shot avail_list
expect_rows "Bench Tools" "Pocket Ruler" "Signal Meter"
key ENTER
wait 500
shot avail_page_long
header avail_page_long "Settings > Apps > Available > Bench Tools" "Apps > Available > Bench Tools" "Available > Bench Tools" "Bench Tools"
expect_rows Description Install Cancel
expect_chevron Description yes
key ENTER
wait 500
shot avail_text_top
key END
wait 500
shot avail_text_bottom
key ESC
wait 500
shot avail_page_back
expect_rows Description Install Cancel
key ESC
wait 500
shot avail_list_back
expect_rows "Bench Tools" "Pocket Ruler" "Signal Meter"
key DOWN
key ENTER
wait 500
shot avail_page_none
expect_rows Install Cancel
key ESC
wait 500
key DOWN
wait 300
key ENTER
wait 500
shot avail_page_short
expect_rows Description Install Cancel
key ENTER
wait 500
shot avail_text_short
key ESC
wait 500
key DOWN
key ENTER
wait 3000
shot avail_install_failed
key ENTER
wait 500
shot avail_install_after
