# The clipboard strip with the on-screen keyboard (docs/dev/clipboard.md, step 2): the strip sits between the field and the keyboard, a
# tap on its buttons neither closes nor opens the keyboard, and the field stays in view above the keyboard. 800x480 only: at 640x480
# and 480x320 the pills shrink (clipboard_strip_osk_tight). Review only.
title clipboard strip with the on-screen keyboard
review
sizes 800x480
env APPLAUNCH_DEV 0
env APPLAUNCH_OSK force
apps Settings CLI SSH Calculator
clock 20:30
wifi 70
bt on
home
clipboard server on
clipboard set "from elsewhere"
fielddemo
wait 600
expect_osk shown
expect_strip Name paste=on copy=on clear=on editing=yes size=row
shot osk_strip
tapclip Name Copy
expect_strip Name copy_text=Copied editing=yes
expect_osk shown
shot osk_strip_copied
tapclip Name Clear
expect_osk shown
expect_strip Name copy=off clear=hide editing=yes
tapclip Name Paste
expect_osk shown
expect_field Name "café €5 and more"
shot osk_strip_pasted
# the password field
key DOWN
key DOWN
key DOWN
expect_osk shown
expect_strip Secret paste=on copy=hide clear=on editing=yes
shot osk_strip_password
