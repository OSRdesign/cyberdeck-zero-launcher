# Native Settings > Apps > Available (task C1, owner decision 2026-10-31): Enter or a tap on an app no longer installs at
# once, it opens the app's page: Description (when it has one: the first line and a chevron, the whole text on a
# read-only page), Install, Cancel. On the fake catalogue with `env HARNESS_APPS_DESC on` (src/harness_apps.cpp): Bench
# Tools has a long description, Pocket Ruler none (no row: Install, Cancel), Signal Meter a one-line one. Shots: the
# Available list, Bench Tools' page, its text page (top, bottom), back on its page and on the list (the highlight on
# Bench Tools), Pocket Ruler's page, Signal Meter's page by touch, its text page by touch, its install (fails while
# preparing: the harness has no sudo; the notice, then the list again with the highlight on Signal Meter).
# Highlighted (centre) row: 480x320 y 180, 640x480 y 267, 800x480 y 268, 720x720 y 392, 1280x720 y 391.
# Review only, no golden.
title settings native apps available page
review
env APPLAUNCH_DEV 0
env APPLAUNCH_OSK auto
env HARNESS_APPS catalogue
env HARNESS_APPS_DESC on
env M5APPSTORE_STATE_DIR /nonexistent/harness-appstore
keyboards 1
apps Settings CLI SSH Calculator
clock 20:30
wifi 70
bt on
home
launch Settings
key UP
key UP
key UP
key UP
key UP
key ENTER
wait 3000
# Available: Bench Tools, Pocket Ruler, Signal Meter
key DOWN
key ENTER
wait 500
shot avail_list
expect_rows "Bench Tools" "Pocket Ruler" "Signal Meter"
# Bench Tools: a long description
key ENTER
wait 500
shot avail_page_long
header avail_page_long "Settings > Apps > Available > Bench Tools" "Apps > Available > Bench Tools" "Available > Bench Tools" "Bench Tools"
expect_rows Description Install Cancel
expect_chevron Description yes
key ENTER
wait 500
shot avail_text_top
key END
wait 500
shot avail_text_bottom
key ESC
wait 500
shot avail_page_back
expect_rows Description Install Cancel
key ESC
wait 500
shot avail_list_back
expect_rows "Bench Tools" "Pocket Ruler" "Signal Meter"
# Pocket Ruler: no description, no row
key DOWN
key ENTER
wait 500
shot avail_page_none
expect_rows Install Cancel
key ESC
wait 500
# Signal Meter by touch: a one-line description
key DOWN
wait 300
@480x320 tap 240 180
@640x480 tap 320 267
@800x480 tap 400 268
@720x720 tap 360 392
@1280x720 tap 640 391
wait 500
shot avail_page_short
expect_rows Description Install Cancel
@480x320 tap 240 180
@640x480 tap 320 267
@800x480 tap 400 268
@720x720 tap 360 392
@1280x720 tap 640 391
wait 500
shot avail_text_short
key ESC
wait 500
# Install: the row below Description, then the job the one-tap row ran (it fails while preparing)
key DOWN
key ENTER
wait 3000
shot avail_install_failed
key ENTER
wait 500
shot avail_install_after
