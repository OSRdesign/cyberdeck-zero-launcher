# Native Settings > Apps (task 014 P3d) with no source yet and a physical keyboard (APPLAUNCH_OSK=auto, one keyboard
# present: the dialog keeps its buttons). The fake Store backend (src/harness_apps.cpp, HARNESS_APPS none) knows only
# the built-in hub, which the page leaves out. Shots: the empty catalogue ("No apps: add your source in Sources"), the
# Sources level with only "+ Add a GitHub source" and "Sync my sources", the entry with Cancel / Add and the address
# typed, the source added ("Source added", 4 apps), back on the Apps tab (Left) on the Sources row, under its apps.
# Review only: no golden.
title settings native apps add a source
review
env APPLAUNCH_SETTINGS_UI native
env APPLAUNCH_DEV 0
env APPLAUNCH_OSK auto
env HARNESS_APPS none
env M5APPSTORE_STATE_DIR /nonexistent/harness-appstore
keyboards 1
apps Settings Store CLI SSH Calculator
clock 20:30
wifi 70
bt on
home
launch Settings
key UP
key UP
key UP
key UP
key ENTER
wait 3000
shot apps_empty
header apps_empty "Settings > Apps" Apps
# the Sources row (row 1)
key DOWN
key ENTER
wait 500
shot apps_sources_empty
key ENTER
wait 300
type deck-lab/apps
shot apps_add_typed_kbd
key ENTER
wait 3000
shot apps_source_added
key LEFT
wait 500
shot apps_list_after_add
