# Settings > Updates > Packages (report 047 P4): what refuses an upgrade before the password, said in the status line of
# the Packages page (Upgrade N packages pressed): a battery under 50 % not charging (D16), under-voltage now, not enough
# space for the download + the growth + the margin, no network, lists 9 days old. Then the repair: dpkg reports unfinished
# packages (an interrupted install): the first action row is "Repair the installation", its progress page (no bar: the
# repair's length is unknown, "Do not switch off") and its result; an upgrade interrupted while installing (the helper gone)
# offers the same row. Keys only. Review only: no golden.
title updates upgrade guards
review
sizes 640x480 480x800 480x640 720x720 1280x800 480x320
@480x800,480x640 profile pda
env APPLAUNCH_DEV 0
env HARNESS_APPS missing
env HARNESS_SUDO ok
apps Settings CLI SSH Calculator
clock 20:30 2026-11-01
wifi 70
bt on
update net on
update build 0.9.2 release arm64
update answer releases-real.json
apt board pi4b
apt lists-age 1
update battery 30
home
launch Settings
wait 300
key UP
key UP
key UP
key UP
key ENTER
wait 3000
key DOWN
key ENTER
wait 1500
key DOWN
# a battery at 30 %, not charging
key ENTER
wait 400
shot guard_battery
expect_text "Battery 30 %: charge it or plug it in"
# charging: under-voltage now
update battery 30 charging
apt undervoltage on
key ENTER
wait 400
shot guard_undervoltage
expect_text "Under-voltage: use a stronger power supply"
# the space
apt undervoltage off
apt space 40
key ENTER
wait 400
shot guard_space
expect_text end "40 MB free"
# no network
apt space 4096
update net off
key ENTER
wait 400
shot guard_network
expect_text "No network"
update net on
key ESC
key ESC
wait 300
# lists 9 days old (a new visit reads them again)
apt lists-age 9
key ENTER
wait 3000
key DOWN
key ENTER
wait 1500
key DOWN
key ENTER
wait 400
shot guard_lists
expect_text "Lists are 9 days old: refresh them first"
key ESC
key ESC
wait 300
# dpkg reports unfinished packages: Repair
apt lists-age 1
apt audit on
key ENTER
wait 3000
key DOWN
key ENTER
wait 1500
shot repair_row
expect_text "Repair the installation"
expect_text "An installation was interrupted: Repair"
key DOWN
key ENTER
wait 600
apt upgrade job repair
apt upgrade state running
apt upgrade phase repair
apt upgrade done 1
apt upgrade total 2
apt upgrade text Configuring halfpkg
apt upgrade started now-0
apt upgrade log /var/log/cyberdeckzero/apt-upgrade-20261101-204000.log
wait 1500
shot repair_progress
header repair_progress "Settings > Updates > Packages > Repairing" "Updates > Packages > Repairing" "Packages > Repairing" Repairing
expect_text start "Finishing the interrupted installation"
expect_text "Do not switch off"
expect_unclipped "Finish the installation" "Do not switch off"
key ESC
wait 300
expect_text start "Finishing the interrupted installation"
apt audit off
apt upgrade state done
apt upgrade done 2
wait 1500
shot repair_result
key ESC
key ESC
key ESC
wait 300
# an upgrade that stopped while installing (a power cut: the helper is gone)
apt upgrade clear
apt upgrade job upgrade
apt upgrade state running
apt upgrade phase install
apt upgrade done 4
apt upgrade total 16
apt upgrade started now-600
update helper-alive off
key ENTER
wait 3000
key DOWN
key ENTER
wait 1500
shot repair_interrupted
expect_text "Repair the installation"
key ESC
key ESC
key ESC
wait 300
