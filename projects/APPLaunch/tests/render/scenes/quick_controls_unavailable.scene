# Quick controls on a board without a Bluetooth adapter (and, second part, without either): the button is dimmed and says
# "Not available"; Enter and a tap on it do nothing; the other buttons work as usual.
# APPLAUNCH_QUICKCTL_ADAPTERS is the test hook of the sysfs probe (/sys/class/bluetooth/hci*, the wireless interfaces).
# Review only: no golden.
title quick controls unavailable
review
env APPLAUNCH_DEV 0
env APPLAUNCH_QUICKCTL_ADAPTERS wifi
apps Settings CLI "Quick controls" SSH Calculator
clock 20:30
wifi 70
bt off
home
launch "Quick controls"
wait 600
shot qc_no_bluetooth
expect_text "Not available"
key RIGHT
key ENTER
wait 300
tapbutton Bluetooth
wait 300
expect_radio bt off
expect_power none
key LEFT
key ENTER
wait 400
expect_radio wifi off
shot qc_no_bluetooth_wifi_off
