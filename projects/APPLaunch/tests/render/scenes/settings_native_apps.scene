# Native Settings > Apps (task 014 P3d; P3e: Installed / Available split), in a release build (APPLAUNCH_DEV=0: Apps
# shows, it is native now) with the on-screen keyboard forced (APPLAUNCH_OSK=force). The fake Store backend
# (src/harness_apps.cpp, HARNESS_APPS catalogue) has the user's sources deck-lab/apps (Packet Radar and Weather Station
# with an update, Field Notes current, Signal Meter not installed), field-kit/tools (its last sync failed: Bad JSON,
# cached list kept; Bench Tools, not installed) and old/archive (off). An install fails while preparing ("Unfinished
# install": the harness has no sudo).
# Shots: the root with Apps, the Apps root (Installed (3), Available (2), Sources), Installed (Update all (2), the
# installed apps with their versions), the remove confirmation of Field Notes (D), back on the Apps root on Installed
# (Left), Available (Bench Tools, Signal Meter), the failed install's message (Enter on Signal Meter), the Sources
# level, the failed source's reason in the status line, its remove confirmation (Del), the add-source entry with the
# keyboard (A), letters typed, the address refused, a sync (S) with its result, back on the Apps root on Sources, back
# to the Settings root.
# Review only: no golden; headers checked against the home grid's (run.sh header).
title settings native apps
review
env APPLAUNCH_DEV 0
env APPLAUNCH_OSK force
env HARNESS_APPS catalogue
env M5APPSTORE_STATE_DIR /nonexistent/harness-appstore
apps Settings Store CLI SSH Calculator
clock 20:30
wifi 70
bt on
home
header home
launch Settings
# root: Screen, Wi-Fi, Bluetooth, Launcher, Touch, Apps, User, Date & Time, System
key UP
key UP
key UP
key UP
shot apps_root
key ENTER
wait 3000
shot apps_list
header apps_list "Settings > Apps" Apps
# Installed: Update all (2), Field Notes, Packet Radar, Weather Station...
key ENTER
wait 500
shot apps_installed
header apps_installed "Settings > Apps > Installed" "Apps > Installed" Installed
key DOWN
shortcut d
shot apps_remove_confirm
key ESC
wait 300
key LEFT
wait 500
shot apps_back_installed
# Available: Bench Tools, Signal Meter
key DOWN
key ENTER
wait 500
shot apps_available
header apps_available "Settings > Apps > Available" "Apps > Available" Available
# Signal Meter: install (the harness backend refuses it while preparing)
key DOWN
key ENTER
wait 3000
shot apps_install_failed
key ENTER
wait 300
key LEFT
wait 500
# Sources: deck-lab/apps, field-kit/tools, old/archive, + Add a GitHub source, Sync my sources
key DOWN
key RIGHT
wait 500
shot apps_sources
header apps_sources "Settings > Apps > Sources" "Apps > Sources" Sources
key DOWN
wait 500
shot apps_source_failed
key DELETE
wait 300
shot apps_source_remove
key ESC
wait 300
shortcut a
wait 300
shot apps_add_source
tapkey o
tapkey k
shot apps_add_typed
tapkey ENTER
wait 300
shot apps_add_refused
key ESC
wait 300
key UP
shortcut s
wait 3000
shot apps_synced
key ESC
wait 500
shot apps_back
header apps_back "Settings > Apps" Apps
key ESC
wait 500
shot apps_closed
header apps_closed Settings
