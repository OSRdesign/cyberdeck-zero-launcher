# Native Settings > Apps (task 014 P3d), in a release build (APPLAUNCH_DEV=0: Apps shows, it is native now) with the
# on-screen keyboard forced (APPLAUNCH_OSK=force). The fake Store backend (src/harness_apps.cpp, HARNESS_APPS
# catalogue) has the user's sources deck-lab/apps (Packet Radar and Weather Station with an update, Field Notes
# current, Signal Meter not installed), field-kit/tools (its last sync failed: Bad JSON, cached list kept; Bench Tools)
# and old/archive (off). An install fails while preparing ("Unfinished install": the harness has no sudo).
# Shots: the root with Apps, the Apps tab (Update all (2), versions, Sources last), the remove confirmation of Field
# Notes (D), the failed install's message, the Sources level, the failed source's reason in the status line, its
# remove confirmation (Del), the add-source entry with the keyboard (A), letters typed, the address refused, a sync
# (S) with its result, back to Apps on the Sources row, back to the root.
# Review only: no golden; headers checked against the home grid's (run.sh header).
title settings native apps
review
env APPLAUNCH_SETTINGS_UI native
env APPLAUNCH_DEV 0
env APPLAUNCH_OSK force
env HARNESS_APPS catalogue
env M5APPSTORE_STATE_DIR /nonexistent/harness-appstore
apps Settings Store CLI SSH Calculator
clock 20:30
wifi 70
bt on
home
header home ZERO
launch Settings
# root: Screen, Wi-Fi, Bluetooth, Launcher, Touch, Apps, User, Date & Time, System
key UP
key UP
key UP
key UP
shot apps_root
key ENTER
wait 3000
shot apps_list
header apps_list "Settings > Apps" Apps
# Update all (2), Bench Tools, Field Notes, Packet Radar, Signal Meter, Weather Station..., Sources
key DOWN
key DOWN
shortcut d
shot apps_remove_confirm
key ESC
wait 300
# Signal Meter: install (the harness backend refuses it while preparing)
key DOWN
key DOWN
key ENTER
wait 3000
shot apps_install_failed
key ENTER
wait 300
# Sources: deck-lab/apps, field-kit/tools, old/archive, + Add a GitHub source, Sync my sources
key RIGHT
wait 500
shot apps_sources
header apps_sources "Settings > Apps > Sources" "Apps > Sources" Sources
key DOWN
wait 500
shot apps_source_failed
key DELETE
wait 300
shot apps_source_remove
key ESC
wait 300
shortcut a
wait 300
shot apps_add_source
tapkey o
tapkey k
shot apps_add_typed
tapkey ENTER
wait 300
shot apps_add_refused
key ESC
wait 300
key UP
shortcut s
wait 3000
shot apps_synced
key ESC
wait 500
shot apps_back
header apps_back "Settings > Apps" Apps
key ESC
wait 500
shot apps_closed
header apps_closed Settings
