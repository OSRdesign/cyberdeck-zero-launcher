# Settings > Apps checks for app updates when it opens (settings_apps_autocheck.hpp), on the fake catalogue
# (src/harness_apps.cpp) whose lists were saved an hour before the scene's clock (HARNESS_APPS_SYNCED 3600; a re-read in
# "newer" mode makes deck-lab/apps offer Field Notes 0.9.3, field-kit/tools keeps failing, old/archive is off).
# Shots: no default route: the cached lists at once and "Offline: showing the list from 1 h ago", nothing re-read; back to
# Settings, the route back, Apps again: the stale sources are re-read in the background, "Up to date (just now)", and
# Installed has Field Notes "0.9.2>0.9.3" in yellow and Update all (3); Apps again a minute later: nothing re-read (tried
# less than 10 min ago), "Updated 1 min ago", which becomes "Updated 3 min ago" while the page stays open; Sources ends
# with the setting row "Check for updates when opening Apps" (on), Enter switches it off; Apps again 20 min later: no
# check, no line (as before the feature); a full config store: switching it on cannot be saved.
# Review only: no golden.
title settings native apps autocheck
review
sizes 640x480 480x320 320x480 480x640 480x800 800x480 720x720 1280x720
@320x480 profile p320
@480x640,480x800 profile pda
@480x640,480x800 env APPLAUNCH_PDA 0
env APPLAUNCH_DEV 0
env HARNESS_APPS catalogue
env HARNESS_APPS_SYNCED 3600
env M5APPSTORE_STATE_DIR /nonexistent/harness-appstore
keyboards 1
apps Settings CLI SSH Calculator
clock 20:30
wifi 70
bt on
update net off
appsrefresh newer
home
launch Settings
# root: Screen, Wi-Fi, Bluetooth, Launcher, Touch, Apps, Updates, User, Date & Time, System
key UP
key UP
key UP
key UP
key UP
key ENTER
wait 3000
shot autocheck_offline
expect_text "Offline: showing the list from 1 h ago"
expect_text "Installed (3)"
key ESC
wait 500
update net on
key ENTER
wait 3000
shot autocheck_fresh
expect_text "Up to date (just now)"
key ENTER
wait 500
key DOWN
wait 300
shot autocheck_installed
expect_text "Update all (3)"
expect_text "0.9.2>0.9.3"
expect_color "0.9.2>0.9.3" F0B400
key LEFT
wait 300
key ESC
wait 500
clock 20:31
key ENTER
wait 3000
shot autocheck_again
expect_text "Updated 1 min ago"
clock 20:33
wait 500
shot autocheck_aging
expect_text "Updated 3 min ago"
# Sources: the sources, + Add a GitHub source, Sync my sources, the setting (Up from the first row: the last one)
key DOWN
key DOWN
key ENTER
wait 500
expect_text "Sync my sources"
key UP
wait 300
shot autocheck_setting_on
key ENTER
wait 300
shot autocheck_setting_off
key ESC
wait 300
key ESC
wait 500
clock 20:50
key ENTER
wait 3000
shot autocheck_off_opened
expect_text "Installed (3)"
configfull on
key DOWN
key DOWN
key ENTER
wait 500
key UP
key ENTER
wait 300
shot autocheck_setting_unsaved
expect_text "Could not save the setting"
expect_color "Could not save the setting" FF6666
