# The switcher's name wrap (report 038 S2, section 3.4) on the densest portrait canvas: the deck's 2.8" 640x480 panel
# turned to 480x640 (56.6x42.5 mm, 11.3 px/mm; not a PDA target, report 038 section 4). There the line beside a card's
# X is about 47 px, narrower than "Serial": the name starts under the X (it was "Ser" / "ial Con..." before S2).
# Review only (no golden).
title pda switcher dense
review
sizes 480x640
profile pda
# the portrait launcher without the writing zone (report 040, S2): kept as the regression of a portrait canvas
# without APPLAUNCH_PDA; the zone itself: the zone_* scenes (report 041)
env APPLAUNCH_PDA 0
env APPLAUNCH_PANEL_MM 56.6x42.5
apps "Serial Console=cli_100.png" "Mesh Hop=fixture:ip_panel_100.png" "RSS Reader=fixture:store_100.png" "System Monitor=fixture:game_100.png" "Net Toolbox=ssh_100.png" "An App With A Thirty Char Name=math_100.png" Settings
clock 20:30
wifi 70
bt on
home
header home
switcher "Serial Console=front" "Mesh Hop=running" "RSS Reader=paused"
shot pda_dense_switcher_three
# no header check: at 11.3 px/mm the title budget is 171 px and "Open apps" (about 178 px) is cut (report 040)
expect_targets
switcher "Serial Console=front" "System Monitor=running" "Net Toolbox=paused" "An App With A Thirty Char Name=nr"
shot pda_dense_switcher_names
expect_targets
switcher off
