# Native Bluetooth pages (task 014 P3c), in a release build (APPLAUNCH_DEV=0) with the on-screen keyboard forced
# (APPLAUNCH_OSK=force: the harness has no presence watcher). The fake BlueZ (src/harness_services.cpp) knows three
# paired devices (M4 keyboard connected, headphones with a long name, a car kit) and the adapter "zero7".
# Shots: the Bluetooth section (Power, Alias, Discoverable, Named Only, Paired Devices, Scan), Paired Devices (names,
# "Connected" / "Paired", the long name cut with dots), the headphones' actions (Connect, Forget, Rename), the Forget
# confirmation, the Rename dialog with the keyboard and a letter typed, the list after the rename (status line), the
# Alias page with the keyboard, edited, and the section after saving ("Alias: zerodeck").
# Review only: no golden; headers checked against the home grid's (run.sh header). The status strip is the one every
# header scene shares (wifi 70, bt on, 20:30): the fake list's connected keyboard does not change it (BtConnectedList).
title settings native bluetooth
review
env APPLAUNCH_DEV 0
env APPLAUNCH_OSK force
apps Settings Store CLI SSH Calculator
clock 20:30
wifi 70
bt on
home
header home
launch Settings
# root: Screen, Wi-Fi, Bluetooth, ...
key DOWN
key DOWN
key ENTER
wait 1000
shot bt_section
header bt_section "Settings > Bluetooth" Bluetooth
# Bluetooth: Power, Alias, Discoverable, Named Only, Paired Devices, Scan
key DOWN
key DOWN
key DOWN
key DOWN
key ENTER
wait 1500
shot bt_paired
# the page title is "Paired" (the row "Paired Devices": whole left of the strip's reserved SSH slot, 2026-10-30)
header bt_paired "Settings > Bluetooth > Paired" "Bluetooth > Paired" "Paired"
# the connected keyboard's actions (Disconnect first), then the headphones' (a title too long: cut with dots)
key ENTER
wait 300
shot bt_device_connected
header bt_device_connected "Settings > Bluetooth > Paired > M4 keyboard" "Bluetooth > Paired > M4 keyboard" "Paired > M4 keyboard" "M4 keyboard"
key ESC
wait 300
key DOWN
key ENTER
wait 300
shot bt_device_actions
# Forget: the confirmation (Cancel, Forget), cancelled
key DOWN
key ENTER
shot bt_forget_confirm
key ESC
wait 300
# Rename: the name in a field, the keyboard up (the dialog's buttons go)
key DOWN
key ENTER
wait 300
tapkey s
shot bt_rename
# 480x320 and 640x480: "Rename" in the header's title place, the header itself unchanged (cp0_ui_dialog.h step 3)
@480x320,640x480 header bt_rename Rename
tapkey ENTER
wait 1500
shot bt_renamed
header bt_renamed "Settings > Bluetooth > Paired" "Bluetooth > Paired" "Paired"
# back to the section, then Alias (row 1)
key ESC
wait 300
key UP
key UP
key UP
key ENTER
wait 1000
shot bt_alias
header bt_alias "Settings > Bluetooth > Alias" "Bluetooth > Alias" Alias
tapkey BACKSPACE
tapkey d
tapkey e
tapkey c
tapkey k
shot bt_alias_typed
tapkey ENTER
wait 1500
shot bt_alias_saved
header bt_alias_saved "Settings > Bluetooth" Bluetooth
