menu "APPLaunch"

config APPLAUNCH_CROSS
    bool "cross compile"
    default y if APPLAUNCH_LINUX_X86_CROSS_CP0

choice APPLAUNCH_BUILD_TARGET
    prompt "APPLaunch build target"
    default APPLAUNCH_LINUX_X86_SDL2

config APPLAUNCH_LINUX_X86_SDL2
    bool "Linux x86 SDL2"

config APPLAUNCH_LINUX_X86_CROSS_CP0
    bool "Linux x86 cross CP0"

config APPLAUNCH_LINUX_CP0
    bool "Linux CP0"

endchoice

# Product builds may inspect Linux MMC mounts for the SD card. Keep this
# disabled for SDL targets so host storage is never exposed as product media.
config APPLAUNCH_TARGET_SD_MMC_STORAGE
    bool
    depends on APPLAUNCH_LINUX_CP0 || APPLAUNCH_LINUX_X86_CROSS_CP0
    default y

endmenu
