import os
import sys
import platform
import subprocess
import shutil
import re
import parse as _parse
from pathlib import Path
# iomport env and tools from the SDK's scons project.py
Import('env')
with open(env['PROJECT_TOOL_S']) as f:
    exec(f.read())

rootfs_path=Path(os.environ.get("CONFIG_TOOLCHAIN_SYSROOT", ""))

# define the project's environment
SRCS = []
INCLUDE = []
PRIVATE_INCLUDE = []
# cjson: the SDK's cJSON (Settings > Updates, report 047: GitHub's release list)
REQUIREMENTS = ['cp0_lvgl', 'eventpp', 'utilities', 'lvgl_component', 'freetype', 'pthread', 'cjson']
# REQUIREMENTS = []
STATIC_LIB = []
DYNAMIC_LIB = []
DEFINITIONS = []
DEFINITIONS_PRIVATE = []
LDFLAGS = []
LINK_SEARCH_PATH = []
STATIC_FILES = []

# Generate page_app includes into build output so builds do not rewrite source files.
def run_python_script(script_rel_path, args=None):
    script_path = script_rel_path.get_abspath()
    script_dir = os.path.dirname(script_path)
    cmd = [sys.executable, script_path]
    if args:
        cmd += args
    result = subprocess.run(
        cmd,
        cwd=script_dir,
        capture_output=True,
        text=True
    )
    if result.stdout:
        print(result.stdout, end='')
    if result.stderr:
        print(result.stderr, end='', file=sys.stderr)
    result.check_returncode()

_generated_include_dir = Path(os.getcwd()) / 'build' / 'generated' / 'include'
run_python_script(AFile('ui/generate_page_app_includes.py'),
                  ['--output', str(_generated_include_dir / 'generated' / 'page_app.h')])

# Get git commit short hash for version display
_repo_root = str(Path(os.getcwd()).resolve().parents[2])
try:
    _repo_root = subprocess.check_output(
        ['git', 'rev-parse', '--show-toplevel'],
        stderr=subprocess.DEVNULL
    ).decode().strip()
    _git_commit = subprocess.check_output(
        ['git', 'rev-parse', '--short', 'HEAD'],
        cwd=_repo_root,
        stderr=subprocess.DEVNULL
    ).decode().strip()
except Exception:
    _git_commit = 'unknown'
print('-- Launcher git commit: %s' % _git_commit)
_launcher_version = os.environ.get('APPLAUNCH_VERSION', '0.0.0-dev')
_launcher_channel = os.environ.get('APPLAUNCH_CHANNEL', 'development')
if not re.fullmatch(r'[0-9]+\.[0-9]+\.[0-9]+(?:-[0-9A-Za-z.-]+)?', _launcher_version):
    raise ValueError('APPLAUNCH_VERSION must be a semantic version')
if not re.fullmatch(r'[0-9A-Za-z.-]+', _launcher_channel):
    raise ValueError('APPLAUNCH_CHANNEL contains unsupported characters')
_launcher_build_date = os.environ.get('SOURCE_DATE_EPOCH', '')
if _launcher_build_date:
    import datetime
    try:
        _launcher_build_date = datetime.datetime.fromtimestamp(
            int(_launcher_build_date), datetime.timezone.utc).strftime('%Y-%m-%d')
    except (ValueError, OverflowError):
        raise ValueError('SOURCE_DATE_EPOCH must be a valid Unix timestamp')
else:
    import datetime
    _launcher_build_date = datetime.datetime.now(datetime.timezone.utc).strftime('%Y-%m-%d')
print('-- APPLaunch version: %s (%s, %s)' %
      (_launcher_version, _launcher_channel, _launcher_build_date))


# add srcs
SRCS += Glob('src/*.c*')
SRCS += append_srcs_dir(ADir('ui'))
SRCS += append_srcs_dir(ADir('ui/settings'))
# add includes
INCLUDE += [ADir('.'), ADir('include'), ADir('ui'), str(_generated_include_dir)]


# Inject git commit hash as a compile-time macro
DEFINITIONS += ['-DLAUNCHER_GIT_COMMIT_RAW=%s' % _git_commit]
DEFINITIONS += ['-DLAUNCHER_VERSION_RAW=%s' % _launcher_version]
DEFINITIONS += ['-DLAUNCHER_CHANNEL_RAW=%s' % _launcher_channel]
DEFINITIONS += ['-DLAUNCHER_BUILD_DATE_RAW=%s' % _launcher_build_date]
DEFINITIONS += ['-DLAUNCHER_BUILD']
# Hardware profile for compile-time menu/feature selection (see ui/settings/settings_hw_profile.hpp).
if os.environ.get('APPLAUNCH_HW') == 'pizero2w':
    DEFINITIONS += ['-DAPPLAUNCH_HW_PIZERO2W=1']

# Startup animation (GIF splash): opt-in via environment variable
if os.environ.get('APPLAUNCH_STARTUP_ANIMATION', '0') == '1':
    DEFINITIONS += ['-DAPPLAUNCH_STARTUP_ANIMATION']


# add debug
if 'CONFIG_BACKWARD_CPP_ENABLED' in os.environ:
    REQUIREMENTS += ['Backward_cpp']


# custom lvgl component
lvgl_component = list(filter(lambda x: x['target'] == 'lvgl_component', env['COMPONENTS']))[0]
local_lvgl_override_srcs = Glob('lvgl/lv_freetype*.c')
local_lvgl_override_names = set(Path(str(src)).name for src in local_lvgl_override_srcs)
lvgl_component['SRCS'] = [
    src for src in lvgl_component['SRCS']
    if Path(str(src)).name not in local_lvgl_override_names
]
lvgl_component['SRCS'] += local_lvgl_override_srcs
lvgl_component['PRIVATE_INCLUDE'] = [
    ADir('lvgl'),
    ADir('../../../SDK/github_source/lvgl/lvgl_9_5/lvgl/src/libs/freetype'),
] + lvgl_component['PRIVATE_INCLUDE']


if 'CONFIG_APPLAUNCH_CROSS' in os.environ:
    lvgl_component['DEFINITIONS'] += ['-D_REENTRANT']
    lvgl_component['INCLUDE'] += [rootfs_path/"usr"/"include"/"freetype2",
                                  rootfs_path/"usr"/"include"/"libpng16",
                                  rootfs_path/"usr"/"include"/"libcamera",
                                  ]
    LDFLAGS += [rootfs_path/"usr"/"lib"/"aarch64-linux-gnu"/"libstdc++.so.6"]


# The host SDL2 build (Linux x86_64) needs pkg-config flags
# for the APPLaunch sources and for LVGL's SDL/FreeType features.
if 'CONFIG_APPLAUNCH_LINUX_X86_SDL2' in os.environ:
    lvgl_component['DEFINITIONS'] += pkg_config_cflags("freetype2")
    lvgl_component['REQUIREMENTS'] += pkg_config_ldflags("freetype2")
    DEFINITIONS += pkg_config_cflags("sdl2")
    REQUIREMENTS += pkg_config_ldflags("sdl2")


if 'CONFIG_APPLAUNCH_LINUX_CP0' in os.environ:
    REQUIREMENTS += ['cp0_lvgl']
    REQUIREMENTS += ['input', 'xkbcommon', 'udev']
    # native build (amd64 PCs, report 028): no sysroot, LVGL's FreeType headers from the build box (pkg-config)
    if not os.environ.get('CONFIG_TOOLCHAIN_SYSROOT'):
        lvgl_component['DEFINITIONS'] += ['-D_REENTRANT'] + pkg_config_cflags("freetype2")

# Stage the complete resource tree for the package.
_static_source = os.path.abspath('../APPLaunch')
_staged_applaunch = os.path.abspath(os.path.join('build', 'static', 'APPLaunch'))
_static_copy_ignore_patterns = ('__pycache__', '*.pyc', '*.pyo')
if os.path.exists(_staged_applaunch):
    shutil.rmtree(_staged_applaunch)
shutil.copytree(_static_source,
                _staged_applaunch,
                ignore=shutil.ignore_patterns(*_static_copy_ignore_patterns))
STATIC_FILES += [(_staged_applaunch, 'APPLaunch')]
# register the component to the build system: dist/cyberdeckzero (installed as /usr/share/APPLaunch/bin/cyberdeckzero)
env['COMPONENTS'].append({'target':'cyberdeckzero',
                          'SRCS':SRCS,
                          'INCLUDE':INCLUDE,
                          'PRIVATE_INCLUDE':PRIVATE_INCLUDE,
                          'REQUIREMENTS':REQUIREMENTS,
                          'STATIC_LIB':STATIC_LIB,
                          'DYNAMIC_LIB':DYNAMIC_LIB,
                          'DEFINITIONS':DEFINITIONS,
                          'DEFINITIONS_PRIVATE':DEFINITIONS_PRIVATE,
                          'LDFLAGS':LDFLAGS,
                          'LINK_SEARCH_PATH':LINK_SEARCH_PATH,
                          'STATIC_FILES':STATIC_FILES,
                          'REGISTER':'project'
                          })
