/* Desktop boards only (install.sh writes this file with the launcher's user filled in below). The menu entry
 * "CardputerZero Launcher" runs `systemctl --no-block start applaunch-desktop.service` as that user, and systemd asks
 * polkit (org.freedesktop.systemd1.manage-units), which wants an administrator password by default. Allow that user,
 * and only that user, to start, stop or restart that one unit. The unit stops and starts the desktop itself, as root
 * (Conflicts=, ExecStopPost=): nothing is opened up for the display manager. */
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "applaunch-desktop.service" &&
        subject.user == "@USER@") {
        var verb = action.lookup("verb");
        if (verb == "start" || verb == "stop" || verb == "restart")
            return polkit.Result.YES;
    }
});
