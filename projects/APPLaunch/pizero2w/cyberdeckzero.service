# Appliance boards (the deck, the Pi 3A+): the launcher as a systemd user service, started at boot (lingering).
# install.sh copies it to ~/.config/systemd/user/cyberdeckzero.service and runs, as the user:
#   systemctl --user enable cyberdeckzero.service && systemctl --user restart cyberdeckzero.service
# (it replaces APPLaunch.service of v0.6.0 and earlier, which install.sh stops, disables and removes first).
[Unit]
Description=CyberdeckZero Launcher

[Service]
Environment=APPLAUNCH_DISPLAY=dpi-scaled
Environment=LV_LINUX_FBDEV_DEVICE=/dev/fb0
Environment=APPLAUNCH_ROTATE=0
# Bluetooth keyboard evdev node: find with `ls -l /dev/input/by-id/` or `evtest`
Environment=LV_LINUX_KEYBOARD_DEVICE=/dev/input/bt-keyboard
# (deck: firmware display_rotate=1 already makes fb0 640x480 landscape, so ROTATE=0)
# Deck touch panel: transposed + inverted vs. the picture (measured on the deck; a board profile overrides these):
Environment=APPLAUNCH_TOUCH_SWAP_XY=1
Environment=APPLAUNCH_TOUCH_INVERT_X=0
Environment=APPLAUNCH_TOUCH_INVERT_Y=1
# line-buffered output so log lines survive a hard exit (watchdog) and reach the journal at once
# Optional: APPLAUNCH_FN_KEY=<evdev code> makes a key act as the Cardputer Fn (left unset: Right Alt is AltGr for symbols)
# Standard (non-Cardputer) keyboard: do not apply the Cardputer matrix keymap to its keycodes
Environment=APPLAUNCH_STD_KEYBOARD=1
# Board profile written by install.sh for boards other than the deck ("-": optional; the deck has none, so the
# lines above apply unchanged). systemd lets EnvironmentFile= values override Environment= ones whatever their
# order, so a profile replaces the deck values it names (fb device, rotation, touch axes) and keeps the rest.
EnvironmentFile=-/etc/applaunch/board.conf
WorkingDirectory=/usr/share/APPLaunch
# Let the boot finish first: its console lines keep scrolling on the panel, and once systemd reports the system
# running nothing prints over the launcher any more (it starts on a clean screen). "-" ignores a degraded boot;
# the timeout keeps a stuck unit from holding the launcher back for ever.
TimeoutStartSec=180
ExecStartPre=-/usr/bin/timeout 150 /usr/bin/systemctl is-system-running --wait
ExecStart=/usr/bin/stdbuf -oL -eL /usr/share/APPLaunch/bin/cyberdeckzero
Restart=on-failure

[Install]
WantedBy=default.target
