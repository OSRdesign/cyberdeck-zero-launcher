#!/bin/sh
# Who owns the panel: the kernel's framebuffer text console (fbcon) or the launcher. install.sh copies this file to
# /usr/share/APPLaunch/bin/applaunch-console; the systemd units run it as root.
#
#   applaunch-console unbind               free the panel from the text console (no VT repaint draws over the launcher)
#   applaunch-console bind                 give the panel back to the text console
#   applaunch-console status               print the framebuffer console's state (bound, unbound or absent)
#   applaunch-console restore-desktop UNIT bind, then start the display manager UNIT again (--no-block), unless the
#                                          system is shutting down (a poweroff, reboot, halt or kexec is under way)
#
# Why: the launcher draws on the framebuffer and only redraws what changed. While fbcon is bound to that framebuffer,
# any console repaint (a VT switch, kernel messages, a busy `apt install`) draws the old boot lines over the launcher.
# Unbinding fbcon (vtcon "frame buffer device", bind=0) stops that; the boot lines still show during the boot, since
# applaunch-console.service unbinds only once multi-user.target is reached.
#
# Every command is idempotent and exits 0 when there is no framebuffer console. Test hooks (leave them unset):
# APPLAUNCH_SYSFS replaces /sys, APPLAUNCH_SYSTEMCTL replaces systemctl.
set -u

SYSFS=${APPLAUNCH_SYSFS:-/sys}
SYSTEMCTL=${APPLAUNCH_SYSTEMCTL:-systemctl}

# the vtconsole entry of the framebuffer console ("(M) frame buffer device"); empty when there is none
fbcon_dir() {
    for d in "$SYSFS"/class/vtconsole/vtcon*; do
        [ -r "$d/name" ] || continue
        case "$(cat "$d/name" 2>/dev/null)" in
            *"frame buffer device"*) echo "$d"; return 0 ;;
        esac
    done
    return 1
}

# set_bind 0|1: write the bind file when its value differs
set_bind() {
    want=$1
    d=$(fbcon_dir) || { echo "no framebuffer console: nothing to do"; return 0; }
    have=$(cat "$d/bind" 2>/dev/null || echo "?")
    word=$([ "$want" = 1 ] && echo bound || echo unbound)
    if [ "$have" = "$want" ]; then
        echo "framebuffer console (${d##*/}) already $word"
        return 0
    fi
    if ! echo "$want" > "$d/bind" 2>/dev/null; then
        echo "could not write $d/bind (run as root)" >&2
        return 1
    fi
    echo "framebuffer console (${d##*/}) $word"
}

status() {
    d=$(fbcon_dir) || { echo "absent"; return 0; }
    case "$(cat "$d/bind" 2>/dev/null)" in
        1) echo "bound (${d##*/})" ;;
        0) echo "unbound (${d##*/})" ;;
        *) echo "unknown (${d##*/})" ;;
    esac
}

# true while the system is going down. systemd reports "stopping" as soon as shutdown.target has a start job queued,
# and every poweroff, reboot, halt or kexec (systemctl, or logind's PowerOff/Reboot that the launcher's Settings use)
# queues one in the same transaction that stops the launcher's unit: by the time ExecStopPost= runs it is visible.
# A queued job for one of those targets counts too, in case is-system-running cannot answer.
shutting_down() {
    state=$($SYSTEMCTL is-system-running 2>/dev/null)
    [ "$state" = stopping ] && return 0
    $SYSTEMCTL list-jobs --no-legend 2>/dev/null \
        | grep -Eq '(^|[[:space:]])(poweroff|reboot|halt|kexec|soft-reboot)\.target([[:space:]]|$)'
}

restore_desktop() {
    unit=$1
    set_bind 1 || true
    if shutting_down; then
        echo "the system is shutting down: $unit is not started again"
        return 0
    fi
    # --no-block: this runs inside the launcher unit's stop; the display manager's start waits for that stop to end
    if $SYSTEMCTL --no-block start "$unit"; then
        echo "desktop: $unit started again"
    else
        echo "could not start $unit" >&2
        return 1
    fi
}

case "${1:-}" in
    unbind) set_bind 0 ;;
    bind) set_bind 1 ;;
    status) status ;;
    restore-desktop)
        [ -n "${2:-}" ] || { echo "restore-desktop needs the display manager unit (e.g. lightdm.service)" >&2; exit 2; }
        restore_desktop "$2" ;;
    -h|--help) sed -n '2,17p' "$0" ;;
    *) echo "usage: applaunch-console unbind|bind|status|restore-desktop UNIT" >&2; exit 2 ;;
esac
