# Appliance boards (the deck, the Pi 3A+): free the panel from the kernel text console once the boot is done, so
# that no console repaint (a VT switch, kernel messages, a busy `apt install`) draws the old boot lines over the
# launcher. The boot lines still show while the system boots, as before.
# install.sh copies it to /etc/systemd/system/ and runs: systemctl enable --now cyberdeckzero-console.service
# (it replaces applaunch-console.service of v0.6.0 and earlier, which install.sh disables and removes first).
#
# Ordering: DefaultDependencies=no + After=multi-user.target runs it after multi-user.target is reached, yet as part of
# the boot transaction (multi-user.target wants it), so systemd reports the system "running" only after it: the
# launcher's user service waits for exactly that (ExecStartPre= ... is-system-running --wait in cyberdeckzero.service).
# At shutdown it stops and gives the panel back to the console, so the shutdown lines show as before.
[Unit]
Description=CyberdeckZero Launcher: free the panel from the text console
DefaultDependencies=no
After=multi-user.target
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/share/APPLaunch/bin/cyberdeckzero-console unbind
ExecStop=/usr/share/APPLaunch/bin/cyberdeckzero-console bind

[Install]
WantedBy=multi-user.target
