# Desktop boards (Raspberry Pi OS desktop: a display manager such as lightdm, with labwc, owns the screen; or a PC with a
# desktop, such as the FZ-M1 tablet with Armbian's XFCE: lightdm and Xorg). install.sh writes this file to
# /etc/systemd/system/cyberdeckzero-desktop.service, with the launcher's user (User=) and the display manager's unit
# (e.g. lightdm.service: Conflicts=, After=, ExecStopPost=) filled in. It replaces applaunch-desktop.service of v0.6.0
# and earlier, which install.sh stops (if it runs) and removes first. A board installed as an appliance gets it when
# install.sh runs again after a desktop was installed (its user service is then stopped, disabled and removed).
# The launcher binary and the board profile are the board's own (arm64 or amd64 bundle, /etc/applaunch/board.conf):
# nothing here names a board or an architecture; the profile's values override the Environment= lines below.
#
# The board boots to its desktop as usual. The user starts the launcher from the applications menu ("CyberdeckZero
# Launcher": systemctl --no-block start cyberdeckzero-desktop.service, allowed without a password by
# 52-cyberdeckzero-desktop.rules): starting this unit stops the desktop (Conflicts=) and the launcher takes the screen.
# When the launcher ends, ExecStopPost= starts the desktop again, unless the system is shutting down.
# There is no [Install] section: the unit cannot be enabled, the launcher never starts at boot on these boards.
[Unit]
Description=CyberdeckZero Launcher (takes the screen from the desktop, gives it back when it exits)
# Starting the launcher stops the desktop. The ordering makes systemd stop the desktop first, and, the other way
# round, finish stopping the launcher before the desktop starts again.
Conflicts=@DM@
After=@DM@
# Default dependencies stay on (Conflicts=shutdown.target, Before=shutdown.target): a poweroff or reboot stops the
# launcher in the same transaction, which is what ExecStopPost= looks at.

[Service]
Type=simple
User=@USER@
# A login session for the user while the launcher runs: /run/user/<uid> (the launcher's state files, the app
# contract) and the user's own services (sound) stay up after the desktop session has ended.
PAMName=login
Environment=APPLAUNCH_DISPLAY=dpi-scaled
Environment=APPLAUNCH_STD_KEYBOARD=1
# Started by this unit, which gives the desktop back on exit: Settings > System > Quit to desktop is shown
Environment=APPLAUNCH_SESSION=desktop
# The board profile written by install.sh: framebuffer, logical size, rotation, panel size, touch (see README.md)
EnvironmentFile=-/etc/applaunch/board.conf
WorkingDirectory=/usr/share/APPLaunch
# As root ("+"), failure ignored ("-"): free the panel from the kernel text console (no VT repaint over the launcher),
# and show VT 7, which has no login prompt: the keys typed in the launcher reach the active VT too (a VT switch that a
# leftover process would hold up is given up after 5 s). lightdm runs X on VT 7 (its default minimum-vt) and X, when
# it stops, switches back to the VT that was active when it started (VT 1 at boot, a login prompt unless getty@tty1
# is masked): VT 7 is free again by then, whichever VT the display manager used. chvt is in the kbd package.
ExecStartPre=-+/usr/share/APPLaunch/bin/cyberdeckzero-console unbind
ExecStartPre=-+/usr/bin/timeout 5 /usr/bin/chvt 7
ExecStart=/usr/bin/stdbuf -oL -eL /usr/share/APPLaunch/bin/cyberdeckzero
# However the launcher ends (Settings > System > Quit to desktop: exit 0; the hold-Esc recovery: exit 75; a crash; a
# kill), the unit stops and the desktop comes back. Never restarted on its own: no restart loop, never a board without a
# screen.
Restart=no
# The one exception: exit status 76, the launcher asking to be started again (Settings > Screen > PDA mode changed: the
# new launcher turns the screen before it draws). systemd restarts the unit whatever Restart= says; ExecStopPost= runs
# in between and leaves the desktop stopped (cyberdeckzero-console sees EXIT_STATUS=76), so Conflicts= does not cancel
# the restart.
RestartForceExitStatus=76
# As root: the text console back, then the desktop, unless the system is shutting down (Settings > System > Shutdown
# or Reboot): then the poweroff or reboot goes on without the desktop coming back in between; or unless the launcher
# restarts (exit status 76, above): the console stays free and the desktop stopped.
ExecStopPost=+/usr/share/APPLaunch/bin/cyberdeckzero-console restore-desktop @DM@
