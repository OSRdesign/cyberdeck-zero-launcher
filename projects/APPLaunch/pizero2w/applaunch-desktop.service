# Desktop boards (Raspberry Pi OS desktop: a display manager such as lightdm, with labwc, owns the screen).
# install.sh writes this file to /etc/systemd/system/applaunch-desktop.service, with the launcher's user (User=) and
# the display manager's unit (e.g. lightdm.service: Conflicts=, After=, ExecStopPost=) filled in.
#
# The board boots to its desktop as usual. The user starts the launcher from the applications menu ("CardputerZero
# Launcher": systemctl --no-block start applaunch-desktop.service, allowed without a password by
# 52-applaunch-desktop.rules): starting this unit stops the desktop (Conflicts=) and the launcher takes the screen.
# When the launcher ends, ExecStopPost= starts the desktop again, unless the system is shutting down.
# There is no [Install] section: the unit cannot be enabled, the launcher never starts at boot on these boards.
[Unit]
Description=CardputerZero launcher (takes the screen from the desktop, gives it back when it exits)
# Starting the launcher stops the desktop. The ordering makes systemd stop the desktop first, and, the other way
# round, finish stopping the launcher before the desktop starts again.
Conflicts=@DM@
After=@DM@
# Default dependencies stay on (Conflicts=shutdown.target, Before=shutdown.target): a poweroff or reboot stops the
# launcher in the same transaction, which is what ExecStopPost= looks at.

[Service]
Type=simple
User=@USER@
# A login session for the user while the launcher runs: /run/user/<uid> (the launcher's state files, the app
# contract) and the user's own services (sound) stay up after the desktop session has ended.
PAMName=login
Environment=APPLAUNCH_DISPLAY=dpi-scaled
Environment=APPLAUNCH_STD_KEYBOARD=1
# Started by this unit, which gives the desktop back on exit: Settings > System > Quit to desktop is shown
Environment=APPLAUNCH_SESSION=desktop
# The board profile written by install.sh: framebuffer, logical size, rotation, panel size, touch (see README.md)
EnvironmentFile=-/etc/applaunch/board.conf
WorkingDirectory=/usr/share/APPLaunch
# As root ("+"), failure ignored ("-"): free the panel from the kernel text console (no VT repaint over the launcher),
# and show VT 7, which has no login prompt: the keys typed in the launcher reach the active VT too (a VT switch that a
# leftover process would hold up is given up after 5 s).
ExecStartPre=-+/usr/share/APPLaunch/bin/applaunch-console unbind
ExecStartPre=-+/usr/bin/timeout 5 /usr/bin/chvt 7
ExecStart=/usr/bin/stdbuf -oL -eL /usr/share/APPLaunch/bin/M5CardputerZero-APPLaunch
# However the launcher ends (Settings > System > Quit to desktop: exit 0; the hold-Esc recovery: exit 75; a crash; a
# kill), the unit stops and the desktop comes back. Never restarted: no restart loop, never a board without a screen.
Restart=no
# As root: the text console back, then the desktop, unless the system is shutting down (Settings > System > Shutdown
# or Reboot): then the poweroff or reboot goes on without the desktop coming back in between.
ExecStopPost=+/usr/share/APPLaunch/bin/applaunch-console restore-desktop @DM@
